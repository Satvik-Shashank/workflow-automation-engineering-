<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Logistics and Shipment Exception Management" processRef="ShipmentExceptionManagement" />
  </bpmn:collaboration>
  <bpmn:process id="ShipmentExceptionManagement" name="Logistics and Shipment Exception Management" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Shipper / Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>book</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Control Tower / System">
        <bpmn:flowNodeRef>validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>tracking</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>outfd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_close</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Pickup Agent">
        <bpmn:flowNodeRef>g_ready</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>resched</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cancel1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>collect</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Hub / Warehouse">
        <bpmn:flowNodeRef>hubs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cancel2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>trace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lost_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_timer</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Delivery Agent">
        <bpmn:flowNodeRef>deliver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_deliv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reattempt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_tries</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>hold_return</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ret</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Shipper books shipment" />
    <bpmn:userTask id="book" name="Create shipment booking" />
    <bpmn:businessRuleTask id="validate" name="Validate address, parcel, charges" />
    <bpmn:serviceTask id="schedule" name="Schedule pickup and assign agent" />
    <bpmn:exclusiveGateway id="g_ready" name="Shipper present, parcel ready?" />
    <bpmn:serviceTask id="resched" name="Reschedule pickup" />
    <bpmn:exclusiveGateway id="g_retry" name="Retries left? (max 2)" />
    <bpmn:endEvent id="end_cancel1" name="Cancelled per policy" />
    <bpmn:manualTask id="collect" name="Collect parcel and scan" />
    <bpmn:parallelGateway id="split" name="Start transport and tracking" />
    <bpmn:sendTask id="tracking" name="Update tracking and notify shipper" />
    <bpmn:serviceTask id="hubs" name="Move through hubs">
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
    </bpmn:serviceTask>
    <bpmn:serviceTask id="cancel_h" name="Intercept, return, refund" />
    <bpmn:endEvent id="end_cancel2" name="Cancelled after dispatch" />
    <bpmn:userTask id="trace" name="Trace parcel (5-day window)" />
    <bpmn:exclusiveGateway id="g_found" name="Parcel found?" />
    <bpmn:serviceTask id="lost_task" name="Declare lost, compensate" />
    <bpmn:endEvent id="end_lost" name="Parcel lost" />
    <bpmn:parallelGateway id="join" name="Both done" />
    <bpmn:sendTask id="outfd" name="Out for delivery, notify" />
    <bpmn:userTask id="deliver" name="Deliver parcel and capture proof" />
    <bpmn:exclusiveGateway id="g_deliv" name="Delivered with proof?" />
    <bpmn:userTask id="reattempt" name="Re-attempt delivery" />
    <bpmn:exclusiveGateway id="g_tries" name="Attempts left? (max 3)" />
    <bpmn:serviceTask id="hold_return" name="Hold 7 days, return" />
    <bpmn:endEvent id="end_ret" name="Returned to sender" />
    <bpmn:serviceTask id="close" name="Close, store proof, invoice" />
    <bpmn:serviceTask id="reconcile" name="Retry, then reconcile" />
    <bpmn:endEvent id="end_ok" name="Shipment delivered" />
    <bpmn:boundaryEvent id="b_msg" name="Shipper cancels" attachedToRef="hubs" cancelActivity="true">
      <bpmn:messageEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_timer" name="No scan 48h" attachedToRef="hubs" cancelActivity="true">
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_close" name="Closure fails" attachedToRef="close" cancelActivity="true">
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="book" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="book" targetRef="validate" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="validate" targetRef="schedule" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="schedule" targetRef="g_ready" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="g_ready" targetRef="collect" name="yes" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="g_ready" targetRef="resched" name="no" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="resched" targetRef="g_retry" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="g_retry" targetRef="end_cancel1" name="no" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="g_retry" targetRef="schedule" name="yes" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="collect" targetRef="split" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="split" targetRef="tracking" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="split" targetRef="hubs" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="tracking" targetRef="join" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="hubs" targetRef="join" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="b_msg" targetRef="cancel_h" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="cancel_h" targetRef="end_cancel2" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="b_timer" targetRef="trace" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="trace" targetRef="g_found" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="g_found" targetRef="lost_task" name="no" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="lost_task" targetRef="end_lost" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="g_found" targetRef="join" name="yes" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="join" targetRef="outfd" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="outfd" targetRef="deliver" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="deliver" targetRef="g_deliv" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="g_deliv" targetRef="close" name="yes" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="g_deliv" targetRef="reattempt" name="no" />
    <bpmn:sequenceFlow id="flow_27" sourceRef="reattempt" targetRef="g_tries" />
    <bpmn:sequenceFlow id="flow_28" sourceRef="g_tries" targetRef="deliver" name="yes" />
    <bpmn:sequenceFlow id="flow_29" sourceRef="g_tries" targetRef="hold_return" name="no" />
    <bpmn:sequenceFlow id="flow_30" sourceRef="hold_return" targetRef="end_ret" />
    <bpmn:sequenceFlow id="flow_31" sourceRef="close" targetRef="end_ok" />
    <bpmn:sequenceFlow id="flow_32" sourceRef="b_close" targetRef="reconcile" />
    <bpmn:sequenceFlow id="flow_33" sourceRef="reconcile" targetRef="end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
