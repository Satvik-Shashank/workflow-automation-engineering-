<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Student Project Approval and Allocation" processRef="StudentProjectApproval" />
  </bpmn:collaboration>
  <bpmn:process id="StudentProjectApproval" name="Student Project Approval and Allocation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Student / Team">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>revise</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>lapsed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_revise</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Project Coordinator">
        <bpmn:flowNodeRef>screen</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Review Committee (HoD)">
        <bpmn:flowNodeRef>evaluate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_rej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rej</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_4" name="Faculty Guide">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>release</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_wd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>exclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_msg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_review</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_5" name="Project Management System">
        <bpmn:flowNodeRef>validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>similarity</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reserve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send_req</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>persist</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retry_h</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_persist</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Team decides to submit" />
    <bpmn:userTask id="submit" name="Submit proposal and team details" />
    <bpmn:serviceTask id="validate" name="Validate fields and team rules" />
    <bpmn:userTask id="screen" name="Screen proposal" />
    <bpmn:serviceTask id="similarity" name="Check topic similarity" />
    <bpmn:userTask id="evaluate" name="Evaluate feasibility and scope" />
    <bpmn:exclusiveGateway id="g_dec" name="Committee decision" />
    <bpmn:userTask id="revise" name="Revise proposal using feedback" />
    <bpmn:endEvent id="lapsed" name="Lapsed" />
    <bpmn:sendTask id="notify_rej" name="Notify rejection with reason" />
    <bpmn:endEvent id="end_rej" name="Rejected" />
    <bpmn:businessRuleTask id="match" name="Match guide by domain and workload" />
    <bpmn:serviceTask id="reserve" name="Allocate top-ranked guide" />
    <bpmn:sendTask id="send_req" name="Send allocation request" />
    <bpmn:receiveTask id="review" name="Receive guide response" />
    <bpmn:serviceTask id="release" name="Release guide slot, close case" />
    <bpmn:endEvent id="end_wd" name="Withdrawn" />
    <bpmn:exclusiveGateway id="g_accept" name="Guide accepts?" />
    <bpmn:serviceTask id="exclude" name="Exclude guide, re-match (max 3)" />
    <bpmn:serviceTask id="persist" name="Persist allocation" />
    <bpmn:serviceTask id="retry_h" name="Retry 3x, then manual notice" />
    <bpmn:sendTask id="notify_ok" name="Notify student: confirmed" />
    <bpmn:endEvent id="end_ok" name="Project allocated and confirmed" />
    <bpmn:boundaryEvent id="b_revise" name="7-day window" attachedToRef="revise" cancelActivity="true">
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_msg" name="Team withdraws" attachedToRef="review" cancelActivity="true">
      <bpmn:messageEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_review" name="No response" attachedToRef="review" cancelActivity="true">
      <bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_persist" name="Save fails" attachedToRef="persist" cancelActivity="true">
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_1" sourceRef="start" targetRef="submit" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="submit" targetRef="validate" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="validate" targetRef="screen" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="screen" targetRef="similarity" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="similarity" targetRef="evaluate" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="evaluate" targetRef="g_dec" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="g_dec" targetRef="match" name="approve" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="g_dec" targetRef="revise" name="revise (max 2 cycles)" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="g_dec" targetRef="notify_rej" name="reject" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="notify_rej" targetRef="end_rej" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="b_revise" targetRef="lapsed" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="revise" targetRef="submit" name="resubmit" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="match" targetRef="reserve" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="reserve" targetRef="send_req" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="send_req" targetRef="review" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="review" targetRef="g_accept" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="b_msg" targetRef="release" />
    <bpmn:sequenceFlow id="flow_18" sourceRef="release" targetRef="end_wd" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="b_review" targetRef="exclude" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="g_accept" targetRef="exclude" name="no" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="exclude" targetRef="match" name="retry" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="g_accept" targetRef="persist" name="yes" />
    <bpmn:sequenceFlow id="flow_23" sourceRef="persist" targetRef="notify_ok" />
    <bpmn:sequenceFlow id="flow_24" sourceRef="b_persist" targetRef="retry_h" />
    <bpmn:sequenceFlow id="flow_25" sourceRef="retry_h" targetRef="notify_ok" />
    <bpmn:sequenceFlow id="flow_26" sourceRef="notify_ok" targetRef="end_ok" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="30" y="30" width="2338" height="1100" /></bpmndi:BPMNShape>
